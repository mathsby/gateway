{
  "name": "@gateway/http-client",
  "version": "0.1.0",
  "description": "A dependency-free HTTP client library with configurable base URL/headers, interceptors, timeout, and retry handling.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "undici": "^6.19.0",
    "vitest": "^4.1.0"
  }
}
