{
  "info": {
    "name": "Client Gateway - Assignments Functional Tests",
    "description": "Functional checks for GET /sites/{siteId}/assignments: 200 happy path, 404 not-found, and 429 rate-limited - each as a self-contained single-run request (no special Collection Runner iteration count needed). For a full sweep of the rate-limit window across 105 requests, see rate-limit.postman_collection.json instead - keep these two suites separate.\n\nNOTE: the 429 test works by firing 100 warm-up requests from its pre-request script, so it deliberately exhausts this IP's rate-limit budget for the next ~60s. Run the requests in this collection top-to-bottom (200, then 404, then 429) so the earlier two aren't accidentally caught by that warm-up. Also avoid running this back-to-back with rate-limit.postman_collection.json within the same minute, or the 200/404 requests may themselves come back 429 from leftover budget usage.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://client-gateway-api.onrender.com" },
    { "key": "siteId", "value": "00000000-0000-0000-0000-000000000001" },
    { "key": "notFoundSiteId", "value": "00000000-0000-0000-0000-000000000000" }
  ],
  "item": [
    {
      "name": "200 - GET assignments (happy path)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/sites/{{siteId}}/assignments",
          "host": ["{{baseUrl}}"],
          "path": ["sites", "{{siteId}}", "assignments"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "    pm.test('Status code is 200', function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "",
              "    pm.test('Content-Type is application/json', function () {",
              "        pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
              "    });",
              "",
              "    pm.test('Body is a non-empty array of assignments', function () {",
              "        const body = pm.response.json();",
              "        pm.expect(body).to.be.an('array');",
              "        pm.expect(body.length).to.be.greaterThan(0);",
              "    });",
              "",
              "    pm.test('Each assignment has the expected shape and siteId', function () {",
              "        const body = pm.response.json();",
              "        const requestedSiteId = pm.variables.get('siteId');",
              "        body.forEach(function (assignment) {",
              "            pm.expect(assignment).to.have.all.keys('id', 'siteId', 'employeeName', 'status', 'startDate', 'endDate');",
              "            pm.expect(assignment.siteId).to.eql(requestedSiteId);",
              "        });",
              "    });",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "404 - GET assignments (unknown site)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/sites/{{notFoundSiteId}}/assignments",
          "host": ["{{baseUrl}}"],
          "path": ["sites", "{{notFoundSiteId}}", "assignments"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "    pm.test('Status code is 404', function () {",
              "        pm.response.to.have.status(404);",
              "    });",
              "",
              "    pm.test('Content-Type is application/problem+json', function () {",
              "        pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/problem+json');",
              "    });",
              "",
              "    pm.test('Body is a ProblemDetails describing the not-found site', function () {",
              "        const body = pm.response.json();",
              "        const requestedSiteId = pm.variables.get('notFoundSiteId');",
              "        pm.expect(body.status).to.eql(404);",
              "        pm.expect(body.title).to.eql('Site not found');",
              "        pm.expect(body.detail).to.include(requestedSiteId);",
              "    });",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "429 - GET assignments (rate limited)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/sites/{{siteId}}/assignments",
          "host": ["{{baseUrl}}"],
          "path": ["sites", "{{siteId}}", "assignments"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The rate limit is 100 requests/minute per IP (see Client.Gateway.Api/Program.cs).",
              "// Fire 100 warm-up requests here so the actual test request below lands as the",
              "// 101st and gets rejected - keeps this a single self-contained run instead of",
              "// needing a 105-iteration Collection Runner (see rate-limit.postman_collection.json",
              "// for that style of test).",
              "//",
              "// Callback form (not async/await): Postman's sandbox parses scripts as classic",
              "// scripts, so top-level await is a syntax error there. The runtime still waits",
              "// for every pending pm.sendRequest call issued during this script to settle",
              "// before it sends the actual request below.",
              "const baseUrl = pm.variables.get('baseUrl');",
              "const siteId = pm.variables.get('siteId');",
              "const url = baseUrl + '/sites/' + siteId + '/assignments';",
              "",
              "for (let i = 0; i < 100; i++) {",
              "    pm.sendRequest(url, function () {});",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "    pm.test('Status code is 429 after the pre-request warm-up exhausts the limit', function () {",
              "        pm.response.to.have.status(429);",
              "    });",
              "",
              "    pm.test('Retry-After header is present', function () {",
              "        pm.response.to.have.header('Retry-After');",
              "    });",
              "",
              "    pm.test('Body is a problem+json 429', function () {",
              "        const contentType = pm.response.headers.get('Content-Type') || '';",
              "        pm.expect(contentType).to.include('application/problem+json');",
              "        pm.expect(pm.response.json().status).to.eql(429);",
              "    });",
              "})();"
            ]
          }
        }
      ]
    }
  ]
}
